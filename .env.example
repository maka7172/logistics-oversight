# ======================
# Logistics Oversight v2 - Environment
# Copy to .env and fill values. Never commit real secrets.
# ======================

COMPOSE_PROJECT_NAME=logistics-oversight

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=logistics
POSTGRES_USER=logistics
POSTGRES_PASSWORD=change_me_strong_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
STORAGE_ENABLED=true
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET=logistics
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_password



# Centrifugo
CENTRIFUGO_API_KEY=change_me_centrifugo_api_key
CENTRIFUGO_ADMIN_PASSWORD=change_me_admin
CENTRIFUGO_TOKEN_SECRET=change_me_very_long_secret_for_jwt

# API
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# JWT (also in secrets.env)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# OTP
OTP_PROVIDER=mock
OTP_EXPIRES_SECONDS=120
OTP_LENGTH=6

# Feature flags (override app.config.yaml)
FEATURE_OFFLINE_SYNC=true
FEATURE_GEOFENCE=true
FEATURE_VRP=true
FEATURE_CHAT=true
FEATURE_SOS=true

# SMS.ir
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_LINE_NUMBER=
OTP_PROVIDER=mock

